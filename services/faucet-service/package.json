{
  "name": "faucet-service",
  "version": "0.1.0",
  "description": "A service for managing faucet operations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergo-faucet/ergo-faucet.git"
  },
  "license": "MIT",
  "author": "ergo-faucet",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx watch ./src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ergo-faucet/accountant": "^0.1.0",
    "@ergo-faucet/controller": "^0.1.0",
    "@ergo-faucet/database": "^0.1.0",
    "@ergo-faucet/discord-auth": "^0.1.0",
    "@ergo-faucet/ergo-authentication": "^0.1.0",
    "@ergo-faucet/ergo-utils": "^0.1.0",
    "@ergo-faucet/fastify-server": "^0.1.0",
    "@ergo-faucet/google-auth": "^0.1.0",
    "@ergo-faucet/google-recaptcha": "^0.1.0",
    "@ergo-faucet/x-auth": "^0.1.0",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/callback-logger": "^2.0.0",
    "@rosen-bridge/winston-logger": "^3.0.0",
    "config": "^3.3.7",
    "lodash-es": "^4.17.21",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/config": "^0.0.41"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
