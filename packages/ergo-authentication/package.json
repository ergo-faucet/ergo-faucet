{
  "name": "@ergo-faucet/ergo-authentication",
  "version": "0.1.0",
  "description": "ergo authentication utilities for ergo-faucet",
  "repository": "https://github.com/TechStack-BlockChain/ergo-faucet.git",
  "license": "GPL-3.0",
  "author": "TechStack-BlockChain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-istanbul": "^3.1.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@ergo-faucet/common-types": "^0.1.0",
    "@ergo-faucet/database": "^0.1.0",
    "@ergo-faucet/fastify-server": "^0.1.0",
    "@fleet-sdk/core": "^0.10.0",
    "@fleet-sdk/crypto": "^0.10.0",
    "@fleet-sdk/wallet": "^0.10.0",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@sinclair/typebox": "^0.34.38",
    "ioredis": "^5.6.1",
    "uuid": "^11.1.0"
  }
}
