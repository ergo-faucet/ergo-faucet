{
  "name": "@ergo-faucet/ergo-authentication",
  "version": "0.1.0",
  "description": "ergo authentication utilities for ergo-faucet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergo-faucet/ergo-faucet.git"
  },
  "license": "MIT",
  "author": "ergo-faucet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@ergo-faucet/common-types": "^0.1.0",
    "@ergo-faucet/database": "^0.1.0",
    "@ergo-faucet/ergo-utils": "^0.1.0",
    "@ergo-faucet/fastify-server": "^0.1.0",
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/wallet": "^0.12.0",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@sinclair/typebox": "^0.34.38",
    "ioredis": "^5.6.1",
    "uuid": "^11.1.0"
  }
}
