{
  "name": "@ergo-faucet/api",
  "version": "0.0.0",
  "description": "API utilities for ergo-faucet",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "20.11.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechStack-BlockChain/ergo-faucet.git"
  },
  "keywords": [
    "ergo",
    "faucet",
    "api"
  ],
  "author": "TechStack-BlockChain",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/TechStack-BlockChain/ergo-faucet/issues"
  },
  "homepage": "https://github.com/TechStack-BlockChain/ergo-faucet#readme",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@rosen-bridge/abstract-logger": "^1.0.0",
    "fastify": "^5.3.3",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-istanbul": "^2.0.5",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vitest": "^2.0.5"
  }
