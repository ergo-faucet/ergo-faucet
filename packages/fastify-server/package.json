{
  "name": "@ergo-faucet/fastify-server",
  "version": "0.0.0",
  "description": "API utilities for ergo-faucet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "20.11.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS=\"--import tsx\" vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechStack-BlockChain/ergo-faucet.git"
  },
  "keywords": [
    "ergo",
    "faucet",
    "fastify-server"
  ],
  "author": "TechStack-BlockChain",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/TechStack-BlockChain/ergo-faucet/issues"
  },
  "homepage": "https://github.com/TechStack-BlockChain/ergo-faucet#readme",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.9",
    "@vitest/coverage-istanbul": "^2.0.5",
    "typescript": "^5.3.3",
    "prettier": "^3.2.4",
    "vitest": "^2.0.5"
  }
}
