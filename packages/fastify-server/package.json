{
  "name": "@ergo-faucet/fastify-server",
  "version": "0.1.0",
  "description": "Fastify server utilities for ergo-faucet",
  "keywords": [
    "ergo",
    "faucet",
    "fastify-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergo-faucet/ergo-faucet.git"
  },
  "license": "MIT",
  "author": "ergo-faucet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ergo-faucet/common-types": "^0.1.0",
    "@ergo-faucet/google-recaptcha": "^0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "fastify": "^5.3.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
