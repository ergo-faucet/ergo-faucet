{
  "name": "@ergo-faucet/database",
  "version": "0.1.0",
  "description": "database utilities for ergo-faucet",
  "repository": "https://github.com/TechStack-BlockChain/ergo-faucet.git",
  "license": "GPL-3.0",
  "author": "TechStack-BlockChain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate lib/migrations/sqlite/migration -- -p -d lib/migrationDataSource/sqliteDataSource.ts && npm run fix-migrations",
    "typeorm:generate:postgres": "npm run typeorm migration:generate lib/migrations/postgres/migration -- -p -d lib/migrationDataSource/postgresDataSource.ts && npm run fix-migrations",
    "typeorm:migrate": "npm run typeorm migration:run -- -d lib/migrationDataSource/sqliteDataSource.ts",
    "fix-migrations": "find lib/migrations -type f -name '*.ts' -exec sed -i \"s#from ['\\\"]typeorm['\\\"]#from '@rosen-bridge/extended-typeorm'#\" {} +",
    "typeorm": "NODE_OPTIONS='--import tsx' typeorm"
  },
  "devDependencies": {
    "@types/node": "^20.11.9",
    "@vitest/coverage-istanbul": "^2.0.5",
    "extensionless": "^1.9.6",
    "prettier": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/extended-typeorm": "^0.1.0",
    "pg": "^8.16.0"
  }
}
